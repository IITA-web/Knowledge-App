{
  "expo": {
    "name": "Knowledge App",
    "slug": "knowledgeapp",
    "version": "2.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1554da32-5090-4cf1-adf6-808a1e98bba1",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "knowledgeapp55",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.iita.knowledgeapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "6"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon_crp.png"
      },
      "permissions": [
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.iita.knowledgeapp",
      "predictiveBackGestureEnabled": false,
      "versionCode": 73
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-location",
      "expo-updates",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-audio",
      "expo-web-browser",
      "@config-plugins/react-native-blob-util",
      "expo-sharing",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow IITA Knowledge to use your photos to diagnose crop diseases.",
          "cameraPermission": "Allow IITA Knowledge to use the camera to photograph crop leaves for disease diagnosis."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "iita",
    "extra": {
      "eas": {
        "projectId": "1554da32-5090-4cf1-adf6-808a1e98bba1"
      }
    }
  }
}
